# 复制到项目根目录 .env 后填写；不要提交真实 .env。
ANIME_PV_PROTOCOL=openai
ANIME_PV_ENDPOINT=https://api.openai.com/v1
ANIME_PV_API_KEY=
ANIME_PV_MODEL=
# 可选 JSON 对象；平台原生参数，不能覆盖 model/prompt/图像输入。
ANIME_PV_PARAMS={}
# 仅 dashscope 使用，必须明确选择：multimodal | multimodal-async
# wan2.6-image完整文生图+参考编辑路径使用multimodal-async
# ANIME_PV_DASHSCOPE_API=multimodal-async
